{
  "permissions": {
    "allow": [
      "Bash(find . -maxdepth 3 -not -path '*/\\\\.*')",
      "mcp__github__get_me",
      "mcp__github__search_repositories",
      "mcp__github__list_issues",
      "Bash(powershell -Command \"Test-Path 'C:\\\\Users\\\\obutr\\\\IdeaProjects\\\\demo3\\\\docs\\\\backlog'\")",
      "Bash(./gradlew.bat compileJava -q)",
      "Bash(./gradlew.bat test *)",
      "Bash(./gradlew.bat dependencies *)",
      "Bash(unzip *)",
      "Bash(./gradlew.bat build *)",
      "mcp__idea__get_project_dependencies",
      "mcp__idea__get_project_modules",
      "mcp__idea__list_directory_tree",
      "mcp__idea__get_file_problems",
      "PowerShell(git *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "github"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-tool.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-backslash-prompt.py\""
          }
        ]
      }
    ]
  },
  "outputStyle": "Concise"
}
